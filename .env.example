# --- Azure OpenAI (deployments created in Azure AI Foundry) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/   # or https://<name>.services.ai.azure.com/ (path is ignored)
# Leave empty to authenticate with Entra ID (az login / managed identity)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21   # REST API version, not the model version (e.g. 2025-04-14)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Evaluation judge model (defaults to the chat deployment); a different model is better
JUDGE_DEPLOYMENT=

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=retail-knowledge-v1
# Semantic ranker needs Basic tier or higher (or the free semantic plan where available)
USE_SEMANTIC_RANKER=false
SEARCH_TIMEOUT_S=10
SEARCH_MAX_RETRIES=3

# azure | memory  (memory = offline in-process index, handy for demos/tests)
SEARCH_BACKEND=azure
# results per search and tool-calling rounds per question
TOP_K=5
MAX_AGENT_STEPS=4

# --- Agent behaviour ---
# Extra LLM call that removes claims not supported by the retrieved sources
ANSWER_GUARD=true
OPENAI_TIMEOUT_S=30
# Retries back off and honour Retry-After on 429/5xx; raise for low-quota deployments
OPENAI_MAX_RETRIES=6

# --- Observability (optional; needs `pip install .[monitor]`) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
WARMUP_ON_STARTUP=true

# --- Security ---
# Comma-separated keys accepted in the X-API-Key header. Empty = no auth (local only!)
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
# Azure AI Content Safety Prompt Shields (optional; F0 tier is free)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=

# --- Deployment (read by the az commands in docs/, not by the app) ---
# Load with:  set -a; source .env; set +a
# New resources (Content Safety, App Insights, Container Apps, Functions) go here; existing
# OpenAI / Search resources keep their own region.
AZURE_LOCATION=eastus2
# only for infra/main.bicep (creating Search from scratch); empty = same as AZURE_LOCATION
AZURE_SEARCH_LOCATION=
AZURE_RESOURCE_GROUP=rg-retail-rag
# short unique prefix for new resource names (<prefix>-safety, <prefix>-api, ...)
AZURE_PREFIX=<unique-name>
