# --- Azure OpenAI (deployments created in Azure AI Foundry) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Leave empty to authenticate with Entra ID (az login / managed identity)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=retail-knowledge
# Semantic ranker needs Basic tier or higher (or the free semantic plan where available)
USE_SEMANTIC_RANKER=false

# azure | memory  (memory = offline in-process index, handy for demos/tests)
SEARCH_BACKEND=azure
